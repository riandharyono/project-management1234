# Salin ke `.env.production` (atau timpa `.env` sebelum build) di server produksi.
# React membaca variabel ini SAAT BUILD, bukan saat aplikasi jalan — kalau
# nilainya diubah, wajib jalankan `yarn build` ulang, restart saja tidak cukup.

# URL API produksi (HTTPS). Kalau API di-proxy dari domain yang sama lewat
# path /api, isi dengan domain itu juga, contoh: https://app.contohdomain.com
REACT_APP_BACKEND_URL=
