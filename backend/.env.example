# Salin file ini jadi `.env` di server produksi, lalu isi SEMUA nilai di bawah
# dengan nilai asli. Jangan pernah pakai nilai contoh di file ini apa adanya.

# Generate dengan: openssl rand -hex 32
JWT_SECRET=

# String koneksi MongoDB. Di production WAJIB pakai autentikasi, contoh:
# mongodb://project_mng_user:PASSWORD_KUAT@127.0.0.1:27017/project_mng?authSource=project_mng
MONGO_URL=
DB_NAME=project_mng
APP_NAME=Project MNG

# Domain frontend yang boleh memanggil API ini (tanpa trailing slash).
# Kalau frontend & API disajikan dari domain yang sama lewat reverse proxy,
# isi dengan domain HTTPS itu, contoh: https://app.contohdomain.com
CORS_ORIGINS=
FRONTEND_URL=

# Akun admin pertama yang otomatis dibuat/disinkronkan saat server start.
# Password ini disamakan ulang setiap restart jika berbeda dari database —
# jadi ganti nilai ini juga jadi cara resmi merotasi password admin nanti.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Batas ukuran upload file dalam MB (default 50 jika tidak diisi)
MAX_UPLOAD_MB=50

# Web push notification (opsional — kosongkan untuk menonaktifkan push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=
